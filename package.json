{
  "name": "lootborne-planner",
  "version": "0.22.1",
  "private": true,
  "description": "Lootborne Planner: builds, XP and PvP planning for Lootborne, from the save file and an optional read-only Frida tap",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && node scripts/package-zip.mjs",
    "dist:installer": "node scripts/package-installer.mjs"
  },
  "dependencies": {
    "frida": "^17.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "frida@17.18.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raafaadg/lootborne-planner.git"
  },
  "author": "Rafael"
}
